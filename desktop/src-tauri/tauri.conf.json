{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creator Source Importer Beta",
  "version": "0.7.1",
  "identifier": "app.creatorsourceimporter.beta",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "resources": [
      "resources/sidecar/**/*",
      "resources/runtime/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  }
}
